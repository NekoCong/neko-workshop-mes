    <url>https://github.com/nekoworks/neko-workshop-mes</url>

    <properties>
        <revision>1.7.1-snapshot</revision>
        <!-- 统一依赖管理 -->
        <spring.boot.version>4.1.1</spring.boot.version>
        <revision.maven.compiler.plugin>3.14.0</revision.maven.compiler.plugin>
        <!-- Web 相关 -->
        <springdoc.version>3.2.0</springdoc.version>
        <knife4j.version>4.5.0</knife4j.version>
        <!-- DB 相关 -->
        <druid.version>1.2.28</druid.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
